# Copy to backend/.env and fill in.

# Required: Claude via langchain-anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# Required by SEC EDGAR's fair-access policy: an app name and a contact email
SEC_USER_AGENT="MarketDetective/0.1 your-email@example.com"

# Optional data sources (the app degrades gracefully without them)
ALPHA_VANTAGE_API_KEY=   # free key: https://www.alphavantage.co/support/#api-key (falls back to yfinance)
NEWSAPI_KEY=             # free key: https://newsapi.org/register (falls back to Yahoo headlines)
FRED_API_KEY=            # free key: https://fred.stlouisfed.org/docs/api/api_key.html (macro checks)

# Investigation limits (defaults follow the Week 4-6 design)
# ANOMALY_Z_THRESHOLD=2.0
# BEAM_WIDTH=2
# MAX_ROUNDS=3
# MAX_EVIDENCE_CHECKS=10
# MAX_API_CALLS_PER_CASE=120
